{
  "cli": {
    "version": ">= 18.7.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development"
    },
    "preview": {
      "distribution": "internal",
      "channel": "preview",
      "env": {
        "SENTRY_DISABLE_AUTO_UPLOAD": "true"
      },
      "android": {
        "buildType": "apk"
      }
    },
    "production": {
      "autoIncrement": true,
      "channel": "production",
      "distribution": "store",
      "android": {
        "buildType": "app-bundle"
      }
    },
    "mesure": {
      "extends": "preview",
      "channel": "mesure",
      "env": {
        "EXPO_PUBLIC_MESURE_CAPTURE": "1",
        "SENTRY_DISABLE_AUTO_UPLOAD": "true"
      }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "ascAppId": "6785268791"
      },
      "android": {
        "track": "production",
        "releaseStatus": "draft"
      }
    }
  }
}
