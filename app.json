{
  "expo": {
    "name": "WillApp",
    "slug": "WillApp",
    "scheme": "will",
    "version": "1.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-white.png",
      "resizeMode": "cover",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.geoffreyzigante.will",
      "usesAppleSignIn": true,
      "associatedDomains": [
        "applinks:will-app.com",
        "applinks:www.will-app.com"
      ],
      "infoPlist": {
        "CFBundleDisplayName": "Will",
        "CADisableMinimumFrameDurationOnPhone": false,
        "NSCameraUsageDescription": "Will utilise la caméra pour prendre ton selfie : c'est lui qui permet de te reconnaître sur les photos de tes courses et de te les envoyer. Si tu photographies un event avec Will, elle sert aussi à capturer les coureurs.",
        "NSMicrophoneUsageDescription": "Will n'enregistre pas d'audio. Cette permission est requise par la librairie camera mais n'est pas utilisee par l'application.",
        "NSPhotoLibraryUsageDescription": "Will peut sauvegarder les photos dans votre galerie.",
        "NSPhotoLibraryAddUsageDescription": "Will peut sauvegarder les photos dans votre galerie.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.INTERNET",
        "android.permission.ACCESS_NETWORK_STATE",
        "android.permission.WAKE_LOCK",
        "android.permission.POST_NOTIFICATIONS"
      ],
      "package": "com.geoffreyzigante.will",
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            { "scheme": "https", "host": "will-app.com", "pathPrefix": "/event/" },
            { "scheme": "https", "host": "www.will-app.com", "pathPrefix": "/event/" }
          ],
          "category": ["BROWSABLE", "DEFAULT"]
        }
      ],
      "blockedPermissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.SYSTEM_ALERT_WINDOW"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "8e0d828b-39bb-4fa3-99a9-98e2712493d8"
      },
      "sentryDsn": "https://2c6ee4fdfc1d3b0dd4c707979f09c6f7@o4511568397205504.ingest.de.sentry.io/4511568409854032"
    },
    "owner": "geoffreyzigante",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/8e0d828b-39bb-4fa3-99a9-98e2712493d8"
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "Will utilise la caméra pour prendre ton selfie : c'est lui qui permet de te reconnaître sur les photos de tes courses et de te les envoyer. Si tu photographies un event avec Will, elle sert aussi à capturer les coureurs."
        }
      ],
      [
        "expo-font",
        {
          "fonts": [
            "./assets/fonts/AV_Estiana-VF.ttf"
          ]
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#7B2FFF",
          "defaultChannel": "photos"
        }
      ],
      [
        "react-native-vision-camera",
        {
          "cameraPermissionText": "Will utilise la caméra pour prendre ton selfie : c'est lui qui permet de te reconnaître sur les photos de tes courses et de te les envoyer. Si tu photographies un event avec Will, elle sert aussi à capturer les coureurs.",
          "enableFrameProcessors": true
        }
      ],
      [
        "expo-build-properties",
        {
          "ios": {
            "deploymentTarget": "16.0"
          }
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-secure-store",
      "./plugins/with-human-detector",
      "./plugins/with-human-detector-android",
      "./plugins/with-exposure-reader",
      "./plugins/with-shutter-lock",
      "./plugins/with-photo-metadata-burner",
      "./plugins/with-photo-quality-scorer",
      "./plugins/with-heic-capture",
      "./plugins/with-background-uploader",
      "./plugins/with-thermal-monitor",
      "./plugins/with-instant-capture"
    ]
  }
}
